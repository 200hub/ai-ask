# 运行命令读取工程根 .env/.env.<mode>/.env.local/.env.<mode>.local；本文件为包级字段说明。
# 优先级：进程 > 模式私有文件 > 共享私有文件 > 模式公共文件 > 公共基础文件 > YAML。
# Core env 枚举为 development / production / test / staging，文件 mode 为 dev / prod / test。
HAI_CORE_NAME=AI Ask
HAI_CORE_VERSION=0.0.1-beta.12
HAI_CORE_ENV=development
HAI_CORE_DEFAULTLOCALE=zh-CN
# trace/debug/info/warn/error/fatal；pretty/json。
HAI_CORE_LOGGING_LEVEL=info
HAI_CORE_LOGGING_FORMAT=pretty

# 开发/test 默认 SQLite；生产必须使用 PostgreSQL。MySQL 当前明确不支持。
HAI_DB_TYPE=sqlite
# SQLite 数据库路径相对 ai-ask-serv 工作目录；保留旧数据时用原文件。
HAI_DB_DATABASE=./data/ai-ask.sqlite
# HAI_DB_TYPE=postgresql 时配置共享数据库；密码仅写私有环境文件。
# HAI_DB_HOST=127.0.0.1
# HAI_DB_PORT=5432
# HAI_DB_DATABASE=ai_ask
# HAI_DB_USER=ai_ask
# HAI_DB_PASSWORD=
# development/test 可用 memory；production 必须配置 Redis，不能绕过框架共享状态要求。
HAI_CACHE_TYPE=memory
# type=redis 后以下配置按 Cache Schema 生效；password 写私有环境文件。
# HAI_CACHE_HOST=127.0.0.1
# HAI_CACHE_PORT=6379
# HAI_CACHE_PASSWORD=
# HAI_CACHE_DB=0
# HAI_CACHE_TLS=false
# HAI_CACHE_KEYPREFIX=ai-ask:

HAI_SERV_SERVER_HOST=127.0.0.1
# 0..65535；0 用于测试时由系统选择端口。
HAI_SERV_SERVER_PORT=1422
# 逗号分隔字符串，不能填 JSON 数组。生产环境需列出实际网页来源。
HAI_SERV_CORS_ORIGIN=http://localhost:1420,http://127.0.0.1:1420
HAI_SERV_CORS_NATIVEORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
# 标准 HTTP 服务可用 HOST/PORT 覆盖监听值；建议优先使用上方 HAI 名称。

# 未配置邮件服务时保持 false；true 才初始化 Reach SMTP 并开放密码重置发送。
HAI_IAM_PASSWORDRESET_ENABLED=false
# 开启时填浏览器可访问的绝对 HTTP(S) URL，包含 /reset-password 路径。
HAI_IAM_PASSWORDRESET_RESETURL=http://127.0.0.1:1422/reset-password
HAI_REACH_PROVIDERS_0_HOST=localhost
HAI_REACH_PROVIDERS_0_PORT=465
# 隐式 TLS 用 true；STARTTLS 通常配置 587 / false。
HAI_REACH_PROVIDERS_0_SECURE=true
# 凭据只写 .env.local 或 .env.<mode>.local；不设置 PUBLIC_/VITE_ 前缀。
# HAI_REACH_PROVIDERS_0_USER=
# HAI_REACH_PROVIDERS_0_PASS=
HAI_REACH_PROVIDERS_0_FROM=noreply@localhost

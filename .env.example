# 公开基础配置见 .env / .env.dev / .env.test / .env.prod。
# 进程环境 > .env.<mode>.local > .env.local > .env.<mode> > .env > YAML。
# 将私密覆盖写入忽略的 .env.local 或 .env.<mode>.local，勿把私钥发给前端。

# 桌面端可公开的 Hai API 绝对地址；留空时保留本地便签和设置中填写地址。
PUBLIC_API_BASE=http://127.0.0.1:1422/api/v1

# Core：显示名、SemVer、模式 development/test/production、界面语言、日志等级。
HAI_CORE_NAME=AI Ask
HAI_CORE_VERSION=0.0.1-beta.12
HAI_CORE_ENV=development
HAI_CORE_DEFAULTLOCALE=zh-CN
HAI_CORE_LOGGING_LEVEL=debug
HAI_CORE_LOGGING_FORMAT=pretty

# 服务端监听与 SQLite，路径相对于 packages/ai-ask-serv，数据库随包目录迁移。
HAI_SERV_SERVER_HOST=127.0.0.1
HAI_SERV_SERVER_PORT=1422
HAI_DB_DATABASE=./data/ai-ask.sqlite

# 来源白名单，逗号分隔字符串；桌面原生来源由 NATIVEORIGINS 指定。
# HAI_SERV_CORS_ORIGIN=http://localhost:1420,http://127.0.0.1:1420
# HAI_SERV_CORS_NATIVEORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost

# 可选密码重置。启用时必须同时填写实际 SMTP 和浏览器可访问的重置 URL。
HAI_IAM_PASSWORDRESET_ENABLED=false
# HAI_IAM_PASSWORDRESET_RESETURL=https://sync.example.com/reset-password
# HAI_REACH_PROVIDERS_0_HOST=smtp.example.com
# HAI_REACH_PROVIDERS_0_PORT=465
# HAI_REACH_PROVIDERS_0_SECURE=true
# HAI_REACH_PROVIDERS_0_USER=sender@example.com
# HAI_REACH_PROVIDERS_0_PASS=仅写入私密覆盖文件
# HAI_REACH_PROVIDERS_0_FROM=sender@example.com

# 生产会话共享缓存；私密密码写入本机覆盖文件或部署注入。
# HAI_CACHE_TYPE=redis
# HAI_CACHE_URL=redis://cache:6379

# 生产数据库（SQLite 仅开发/测试）；密码不应提交到公共文件。
# HAI_DB_TYPE=postgresql
# HAI_DB_HOST=db
# HAI_DB_PORT=5432
# HAI_DB_DATABASE=ai_ask
# HAI_DB_USER=ai_ask
# HAI_DB_PASSWORD=仅写入私密覆盖文件

{
  "name": "ai-ask",
  "type": "module",
  "version": "0.0.1-beta.8",
  "packageManager": "pnpm@12.18.0",
  "description": "AI Ask - 一个简洁高效的AI问答助手",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "test": "pnpm run test:frontend && pnpm run test:rust",
    "test:frontend": "vitest run",
    "test:rust": "cd src-tauri && cargo test",
    "lint": "pnpm run lint:frontend && pnpm run lint:rust",
    "lint:frontend": "eslint src",
    "lint:rust": "cd src-tauri && cargo fmt --check && cargo clippy -- -D warnings",
    "lint:fix": "pnpm run lint:frontend:fix && pnpm run lint:rust:fix",
    "lint:frontend:fix": "eslint src --fix",
    "lint:rust:fix": "cd src-tauri && cargo fmt && cargo clippy --fix --allow-dirty --allow-staged",
    "format": "pnpm eslint src --fix && cd src-tauri && cargo fmt",
    "tauri": "tauri",
    "version:sync": "node .github/scripts/sync-version.js",
    "release:validate": "node .github/scripts/validate-version.js",
    "supabase:setup": "node scripts/setup-supabase.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.72.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "@tauri-apps/plugin-store": "^2.5.1",
    "marked": "^18.2.0",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}

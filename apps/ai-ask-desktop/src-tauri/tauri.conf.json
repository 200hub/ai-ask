{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Ask",
  "version": "../../../package.json",
  "identifier": "com.200hub.aiask",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm compile",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Ask",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "skipTaskbar": false,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "AI Ask"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "© 2026 AI Ask",
    "category": "Productivity",
    "shortDescription": "AI问答助手",
    "longDescription": "一个简洁高效的AI问答助手，支持多平台切换和翻译功能",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "android": {
      "minSdkVersion": 24
    },
    "iOS": {
      "developmentTeam": ""
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBOThEREJCRTk4NkQzQkEKUldTNjA0YnB1OTJZK2luQSsxTFhjNFhPN1FJakx2M2hCWDk4UXRGbHI1b3JIYTlFc3ZBbWhGUEIK",
      "endpoints": [
        "https://github.com/200hub/ai-ask/releases/download/desktop-updates/latest.json"
      ],
      "requireSignedVersion": true,
      "allowDowngrades": false
    }
  }
}

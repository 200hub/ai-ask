{
  "name": "ai-ask-desktop",
  "type": "module",
  "version": "0.0.1-beta.13",
  "packageManager": "pnpm@12.18.0",
  "description": "AI Ask - 一个简洁高效的AI问答助手",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm compile",
    "preview": "vite preview",
    "check": "pnpm typecheck",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "check:i18n": "node ../../scripts/check-i18n-parity.mjs",
    "test": "vitest run",
    "test:frontend": "vitest run",
    "test:e2e": "playwright test",
    "lint": "pnpm lint:frontend",
    "lint:frontend": "eslint src e2e playwright.config.ts vite.config.ts vitest.config.ts config-env.ts svelte.config.js",
    "lint:fix": "pnpm lint:frontend:fix",
    "lint:frontend:fix": "pnpm run lint:frontend --fix",
    "tauri": "node ../../scripts/run-tauri.mjs ../.. packages/ai-ask-serv/config/_core.yml",
    "compile": "vite build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "tauri:dev": "pnpm tauri dev",
    "tauri:build": "pnpm tauri build"
  },
  "dependencies": {
    "@lucide/svelte": "^1.72.0",
    "@h-ai/api-client": "1.0.0-beta.35",
    "@h-ai/core": "1.0.0-beta.35",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-store": "^2.5.1",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "ai-ask-contract": "workspace:*",
    "@h-ai/ui": "1.0.0-beta.35",
    "@tauri-apps/plugin-updater": "2.14.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.14.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "@types/node": "^24.10.0"
  },
  "private": true
}

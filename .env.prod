HAI_CORE_ENV=production
HAI_CORE_LOGGING_LEVEL=warn
# 构建时可填写已部署的公开 API；留空允许桌面用户在设置中指定。
PUBLIC_API_BASE=
# 生产 IAM 会话使用共享缓存，部署时按实际 Redis 地址/私密凭据覆盖。
HAI_CACHE_TYPE=redis
HAI_CACHE_URL=redis://cache:6379
# 生产使用共享关系库；HAI_DB_PASSWORD 必须从私密环境注入。
HAI_DB_TYPE=postgresql
HAI_DB_HOST=db
HAI_DB_PORT=5432
HAI_DB_DATABASE=ai_ask
HAI_DB_USER=ai_ask
